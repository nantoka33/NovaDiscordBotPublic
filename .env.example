# NovaDiscordBot 設定ファイルのひな形です。
# このファイルを ".env" にコピーして値を設定してください。".env" はGitにコミットしないでください。
# 注意: 値の行末にコメントを書かないでください（コメントは必ず独立した行にします）。
#
# Docker（docker compose）で動かす場合も、このファイルを ".env" にコピーして使います。
# Dockerでは、Google OAuthトークンなどの保存先（/app/data）とListenアドレス（0.0.0.0:5000）は
# docker-compose.yml 側で設定されるため、この .env で変更する必要はありません。

# ============================================================
# 【必須】 以下の5項目は必ず設定してください
# ============================================================

# 【必須】Discord Bot Token
DISCORD_TOKEN=

# 【必須】Discord Application ID
DISCORD_CLIENT_ID=

# 【必須】Google OAuth 2.0 クライアントID（ウェブ アプリケーション）
GOOGLE_CLIENT_ID=

# 【必須】Google OAuth 2.0 クライアントシークレット
GOOGLE_CLIENT_SECRET=

# 【必須】Google OAuth のコールバックURL
# Google Cloud の「承認済みのリダイレクトURI」に、まったく同じURLを登録してください。
# ローカルで動かす場合は下記のままで構いません。
GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback

# ============================================================
# 【任意】 必要な場合だけ設定してください（空欄のままで動作します）
# ============================================================

# 【任意】開発用サーバーのID。設定するとSlash Commandがそのサーバーへすぐ反映されます。
# 空欄の場合はグローバル登録になり、反映に時間がかかることがあります。
DISCORD_GUILD_ID=

# 【任意】予定通知を送るチャンネルのID。空欄の場合は通知を送りません。
# Botをサーバーに追加すると menu / bot返信用 / 通知用 のチャンネルを自動作成して登録します（以下3つより優先）。
# 自動作成にはBotの「チャンネルの管理」権限が必要です。固定したい場合のみ設定してください。
DISCORD_NOTIFICATION_CHANNEL_ID=
# 【推奨】共有メニューを投稿するチャンネルID。空欄の場合は通知先チャンネルを使います。
DISCORD_MENU_CHANNEL_ID=

# 【任意】返信用チャンネルのID。「📢 全体に公開」を押したときの公開先です。
# 空欄の場合は、ボタンを押したチャンネル（メニューのあるチャンネル）に公開します。
DISCORD_REPLY_CHANNEL_ID=

# 【任意】Webサーバーの待受アドレス。外部公開するサーバーで使います。
# Dockerではコンテナ内で常に http://0.0.0.0:5000 になります（ホスト側のポートは docker-compose.yml の ports で変更）。
ASPNETCORE_URLS=http://0.0.0.0:5000

# 【任意】保存先DriveフォルダのID。空欄でも、Discordで /googledrive folder を実行して設定できます。
GOOGLE_DRIVE_FOLDER_ID=

# 【任意】コピー元にするテンプレートSpreadsheetのID。
# 空欄の場合は、保存先フォルダに空のSpreadsheetを新規作成します。
GOOGLE_SHEETS_TEMPLATE_ID=
